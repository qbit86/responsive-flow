[*ViewModel.cs]
resharper_member_can_be_private_global_highlighting = hint # MemberCanBePrivate.Global
resharper_unused_auto_property_accessor_global_highlighting = hint # UnusedAutoPropertyAccessor.Global

[InAppMessageViewModel.cs]
dotnet_diagnostic.IDE0072.severity = none # Add missing cases to switch expression

[MainWindowViewModel.cs]
dotnet_diagnostic.CA1031.severity = none # Do not catch general exception types
resharper_collection_never_queried_global_highlighting = hint # CollectionNeverQueried.Global

[MainWindowViewModel.States.cs]
dotnet_diagnostic.IDE0055.severity = none # Formatting rule

[UrlEntryViewModel.cs]
dotnet_diagnostic.CA1056.severity = none # URI properties should not be strings
